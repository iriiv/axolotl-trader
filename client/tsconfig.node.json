{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    /* эмит composite-проекта отводим в служебную папку, чтобы не засорять исходники */
    "outDir": "node_modules/.tmp/tsc-node",
    "tsBuildInfoFile": "node_modules/.tmp/tsc-node/.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
